<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="text"/>
<xsl:decimal-format name="k" grouping-separator="," decimal-separator="." NaN="-" infinity="INF" minus-sign="~" percent="%" zero-digit="0" digit="#"/>
<xsl:template match="/"><xsl:value-of select="format-number(1234.5678, '#,##0.###')"/>|<xsl:value-of select="format-number(-1234.5678, '#,##0.##', 'k')"/>|<xsl:value-of select="format-number(0 div 0, '0', 'k')"/>|<xsl:value-of select="format-number(1 div 0, '0', 'k')"/>|<xsl:value-of select="format-number(0.000123, '0.00000')"/>|<xsl:value-of select="format-number(123456789012345, '#,##0')"/>|<xsl:value-of select="format-number(1.5, '0')"/>|<xsl:value-of select="format-number(2.5, '0')"/>|<xsl:value-of select="format-number(-0.4, '0')"/>|<xsl:value-of select="format-number(12345, '#,##,##0')"/>|<xsl:value-of select="format-number(1, '0.0E0')"/>|<xsl:value-of select="format-number(99.995, '0.00')"/>|<xsl:value-of select="format-number(0.5, '#')"/>|<xsl:value-of select="format-number(-5, '0;')"/>|<xsl:value-of select="format-number(7, 'abc')"/>|<xsl:value-of select="format-number(1234, '#,##0.00;[#,##0.00]')"/>|<xsl:value-of select="format-number(-1234, '#,##0.00;[#,##0.00]')"/></xsl:template></xsl:stylesheet>