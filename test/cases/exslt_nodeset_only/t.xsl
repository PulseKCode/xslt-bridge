<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:exsl="http://exslt.org/common" xmlns:msxsl="urn:schemas-microsoft-com:xslt" xmlns:str="http://exslt.org/strings">
<xsl:output method="text"/>
<xsl:variable name="tmp"><item v="3"/><item v="1"/><item v="2"/></xsl:variable>
<xsl:template match="/"><xsl:for-each select="exsl:node-set($tmp)/item"><xsl:sort select="@v"/><xsl:value-of select="@v"/></xsl:for-each>|<xsl:variable name="s" select="exsl:node-set('abc')"/><xsl:value-of select="count($s)"/>,<xsl:value-of select="$s"/>,<xsl:value-of select="count($s/self::text())"/>,<xsl:value-of select="count($s/..)"/>|<xsl:value-of select="function-available('exsl:node-set')"/>,<xsl:value-of select="function-available('exsl:object-type')"/>,<xsl:value-of select="function-available('msxsl:node-set')"/>,<xsl:value-of select="function-available('str:tokenize')"/>|<xsl:choose><xsl:when test="function-available('msxsl:node-set')">ms</xsl:when><xsl:otherwise>exsl</xsl:otherwise></xsl:choose>|<xsl:value-of select="count(exsl:node-set(exsl:node-set($tmp)/item))"/></xsl:template></xsl:stylesheet>